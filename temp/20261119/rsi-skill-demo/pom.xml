<?xml version="1.0" encoding="UTF-8"?>
<!--
  RSI skill 改进 demo（可选构建方式）。
  默认运行方式为纯 javac/java classpath（见 run_demo.bat），本 pom 仅用于切换到 Maven 构建。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>rsi-skill-demo</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <openjiuwen.version>0.1.17</openjiuwen.version>
    <jackson.version>2.21.5</jackson.version>
  </properties>

  <dependencies>
    <!-- RSI 运行时实现（含 harness_rsi 单 skill 迭代优化引擎） -->
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>core-rsi</artifactId>
      <version>${openjiuwen.version}</version>
    </dependency>
    <!-- RSI SPI + DeepAgent 运行时 -->
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-core-java</artifactId>
      <version>${openjiuwen.version}</version>
    </dependency>
    <!-- JSON 解析（dataset.json / 评测输入输出） -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>rsi-skill-demo</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.example.rsidemo.RsiSkillDemo</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
