#!/bin/bash
#
# pre-commit hook: 检查待提交文件中是否包含敏感信息
# 敏感信息类型：API Key、密码、凭证、Token、Secret、私钥等
# 如发现敏感信息，阻止提交并输出详细报告
#
# 安装：将此文件放到 .git/hooks/pre-commit，确保可执行 (chmod +x)
#

set -euo pipefail

# ── 颜色定义 ──
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
NC='\033[0m'

# ── 敏感信息检测规则 ──
# 格式：规则名|正则模式|描述
RULES=(
  "API_Key_OpenAI|sk-[A-Za-z0-9]{20,}|OpenAI/类似格式的 API Key (sk-xxx...)"
  "API_Key_Hardcoded|[Aa]pi[_-]?[Kk]ey\s*[:=]\s*['\"]?[A-Za-z0-9\-._]{16,}['\"]?|硬编码的 api_key 值 (≥16字符)"
  "Password_Hardcoded|[Pp]assword\s*[:=]\s*['\"]?[A-Za-z0-9\-._@!#$%^&*]{6,}['\"]?|硬编码的 password 值 (≥6字符)"
  "Password_YML|password:\s+[A-Za-z0-9\-._@!#$%^&*]{6,}|YAML 中的 password 值"
  "Secret_Hardcoded|[Ss]ecret[_-]?[Kk]ey\s*[:=]\s*['\"]?[A-Za-z0-9]{16,}|硬编码的 secret_key 值"
  "Token_Hardcoded|[Tt]oken\s*[:=]\s*['\"]?[A-Za-z0-9\-._]{20,}['\"]?|硬编码的 token 值 (≥20字符)"
  "Private_Key|private[_-]?key\s*[:=]\s*['\"]?[^'\"]{20,}|硬编码的 private_key 值"
  "AWS_Access_Key|AKIA[0-9A-Z]{16}|AWS Access Key ID"
  "GitHub_PAT|ghp_[A-Za-z0-9]{36,}|GitHub Personal Access Token"
  "GitHub_OAuth|gho_[A-Za-z0-9]{36,}|GitHub OAuth Token"
  "JWT_Secret|[Jj]wt[_-]?[Ss]ecret\s*[:=]\s*['\"]?[A-Za-z0-9]{16,}|硬编码的 JWT Secret"
  "Bearer_Token|Bearer\s+[A-Za-z0-9\-._~+/]+=*|HTTP Bearer Token 值"
)

# ── 白名单：允许的占位符/示例值（精确匹配） ──
# 只有当敏感值完全等于这些值时才放行，不做子串匹配
ALLOWED_EXACT=(
  "password"
  "123456"
  "admin123"
  "admin123456"
  "root"
  "test"
  "demo"
  "example"
  "placeholder"
  "your_password"
  "your-password"
  "CHANGE_ME"
  "xxx"
  "your_api_key"
  "your-api-key"
  "your_secret"
  "your-secret"
  "your_token"
  "your-token"
  "sk-placeholder"
  "sk-test"
  "sk-example"
  "sk-your-api-key"
  "none"
  "null"
  "empty"
  "default"
  "changeme"
)

# ── 获取待提交文件列表 ──
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
  printf "${GREEN}✅ 没有待提交的文件，跳过敏感信息检查${NC}\n"
  exit 0
fi

# ── 过滤可检查的文件 ──
CHECKABLE_FILES=""
for FILE in $STAGED_FILES; do
  # 排除二进制文件
  if [[ "$FILE" =~ \.(png|jpg|jpeg|gif|bmp|ico|svg|woff|woff2|ttf|eot|jar|class|so|dll|exe|bin|zip|tar|gz|rar|7z|pdf)$ ]]; then
    continue
  fi
  # 排除已删除的文件
  if [ ! -f "$FILE" ]; then
    continue
  fi
  CHECKABLE_FILES="$CHECKABLE_FILES $FILE"
done

if [ -z "$CHECKABLE_FILES" ]; then
  printf "${GREEN}✅ 待提交文件均为二进制/不可读文件，跳过敏感信息检查${NC}\n"
  exit 0
fi

# ── 执行检测 ──
FOUND_ISSUES=0
ISSUE_DETAILS=""

for FILE in $CHECKABLE_FILES; do
  # 获取 diff 中新增/修改的行（+开头，排除 +++ 头部行）
  DIFF_CONTENT=$(git diff --cached -- "$FILE" 2>/dev/null | grep '^+' | grep -v '^+++' || true)

  # 如果没有 diff（可能是新文件且已 staged），则读取整个文件
  if [ -z "$DIFF_CONTENT" ]; then
    DIFF_CONTENT=$(cat "$FILE" 2>/dev/null || true)
  fi

  if [ -z "$DIFF_CONTENT" ]; then
    continue
  fi

  for RULE_ENTRY in "${RULES[@]}"; do
    RULE_NAME=$(echo "$RULE_ENTRY" | cut -d'|' -f1)
    RULE_PATTERN=$(echo "$RULE_ENTRY" | cut -d'|' -f2)
    RULE_DESC=$(echo "$RULE_ENTRY" | cut -d'|' -f3)

    # 搜索匹配行
    while IFS= read -r MATCH_LINE; do
      [ -z "$MATCH_LINE" ] && continue

      # 提取匹配的敏感值
      SENSITIVE_VALUE=$(echo "$MATCH_LINE" | grep -Po "$RULE_PATTERN" 2>/dev/null | head -1 || true)
      [ -z "$SENSITIVE_VALUE" ] && continue

      # 检查是否在白名单中（精确匹配）
      IS_ALLOWED=false
      for ALLOWED in "${ALLOWED_EXACT[@]}"; do
        if [[ "$SENSITIVE_VALUE" == "$ALLOWED" ]]; then
          IS_ALLOWED=true
          break
        fi
      done

      if [ "$IS_ALLOWED" = true ]; then
        continue
      fi

      # 脱敏显示
      LEN=${#SENSITIVE_VALUE}
      if [ "$LEN" -gt 12 ]; then
        MASKED="${SENSITIVE_VALUE:0:4}***${SENSITIVE_VALUE: -4}"
      elif [ "$LEN" -gt 6 ]; then
        MASKED="${SENSITIVE_VALUE:0:3}***${SENSITIVE_VALUE: -2}"
      else
        MASKED="${SENSITIVE_VALUE:0:2}***"
      fi

      FOUND_ISSUES=$((FOUND_ISSUES + 1))
      ISSUE_DETAILS="${ISSUE_DETAILS}  ❌ [${RULE_NAME}] ${FILE}\n     规则: ${RULE_DESC}\n     匹配: ${MASKED} (长度=${LEN})\n\n"
    done < <(echo "$DIFF_CONTENT" | grep -P "$RULE_PATTERN" 2>/dev/null || true)
  done
done

# ── 输出结果 ──
if [ "$FOUND_ISSUES" -gt 0 ]; then
  printf "\n"
  printf "${RED}${BOLD}🚨🚨🚨  检测到 ${FOUND_ISSUES} 处敏感信息！提交已被阻止  🚨🚨🚨${NC}\n"
  printf "\n"
  printf "${YELLOW}${BOLD}详细报告：${NC}\n\n"
  printf "${ISSUE_DETAILS}"
  printf "${YELLOW}${BOLD}处理建议：${NC}\n"
  printf "  1. 将真实密码/Key 替换为占位符（如 password: CHANGE_ME, api_key: <your_api_key>）\n"
  printf "  2. 将敏感配置移到环境变量或 .env 文件（并确保 .env 已加入 .gitignore）\n"
  printf "  3. SQL 初始化数据中的 API Key 使用占位符，首次部署时由管理员手动录入\n"
  printf "  4. 文档中的示例使用虚构值（如 http://example.com/v1, sk-placeholder1234）\n"
  printf "\n"
  printf "${YELLOW}如确认这些值可以公开（如测试/示例值），可临时跳过检查：${NC}\n"
  printf "  ${BOLD}git commit --no-verify${NC}\n"
  printf "\n"
  exit 1
else
  printf "${GREEN}✅ 敏感信息检查通过：未发现密码、API Key、凭证等敏感数据${NC}\n"
  exit 0
fi
