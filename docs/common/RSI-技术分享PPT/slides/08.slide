        <Text style={{ fontSize: 32, color: '#1A1A1A', fontWeight: 'bold' }}>第三代：Harness 递归改进</Text>
        <Box style={{ width: '100%', height: 2, background: '#C8102E', marginTop: 2 }} />
    </Box>
    <Box style={{
        display: 'flex',
        flexDirection: 'row',
        gap: 24,
        flex: 1,
    }}>
        <Box style={{
            flex: 1,
            display: 'flex',
            flexDirection: 'column',
            gap: 14,
        }}>
            <Box style={{
                border: '1px solid #E5E5E5',
                borderRadius: 8,
                padding: 16,
                display: 'flex',
                flexDirection: 'column',
                gap: 8,
