<Slide style={{
    width: '1280px',
    height: '720px',
    background: '#FFFFFF',
    padding: '50px 80px',
    display: 'flex',
    flexDirection: 'column',
}}>
    <Box style={{
        display: 'flex',
        flexDirection: 'column',
        gap: 4,
        marginBottom: 20,
    }}>
        <Text style={{ fontSize: 14, color: '#C8102E', fontWeight: 'bold' }}>07 落地思考</Text>
        <Text style={{ fontSize: 30, color: '#1A1A1A', fontWeight: 'bold' }}>重中之重 —— 数据</Text>
        <Box style={{ width: '100%', height: 2, background: '#C8102E', marginTop: 2 }} />
    </Box>
    <Box style={{
        display: 'flex',
        flexDirection: 'row',
        gap: 20,
        flex: 1,
    }}>
        <Box style={{
            flex: 1,
            border: '1px solid #E5E5E5',
            borderRadius: 8,
            padding: 20,
            display: 'flex',
            flexDirection: 'column',
            gap: 14,
        }}>
            <Box style={{ display: 'flex', flexDirection: 'row', gap: 10, alignItems: 'center' }}>
                <Box style={{ width: 28, height: 28, borderRadius: 4, background: '#C8102E', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold' }}>1</Text>
                </Box>
                <Text style={{ fontSize: 18, color: '#C8102E', fontWeight: 'bold' }}>数据采集</Text>
            </Box>
            <Text style={{ fontSize: 13, color: '#999999' }}>RSI 循环的原料层</Text>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                <Box style={{ display: 'flex', flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#C8102E', marginTop: 6, flexShrink: 0 }} />
                    <Text style={{ fontSize: 14, color: '#333333', lineHeight: 1.5 }}>LLM 调用日志</Text>
                </Box>
                <Box style={{ display: 'flex', flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#C8102E', marginTop: 6, flexShrink: 0 }} />
                    <Text style={{ fontSize: 14, color: '#333333', lineHeight: 1.5 }}>调用链（trace）</Text>
                </Box>
                <Box style={{ display: 'flex', flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#C8102E', marginTop: 6, flexShrink: 0 }} />
                    <Text style={{ fontSize: 14, color: '#333333', lineHeight: 1.5 }}>Issue / PR / Commit 记录</Text>
                </Box>
                <Box style={{ display: 'flex', flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#C8102E', marginTop: 6, flexShrink: 0 }} />
                    <Text style={{ fontSize: 14, color: '#333333', lineHeight: 1.5 }}>代码检视意见</Text>
                </Box>
            </Box>
            <Box style={{ background: '#F8F8F8', borderRadius: 4, padding: 10, marginTop: 'auto' }}>
                <Text style={{ fontSize: 12, color: '#666666', lineHeight: 1.5 }}>
                    示例：抓包分析网页请求并模拟请求（6.7G 原始数据）
                </Text>
            </Box>
        </Box>
        <Box style={{
            flex: 1,
            border: '1px solid #E5E5E5',
            borderRadius: 8,
            padding: 20,
            display: 'flex',
            flexDirection: 'column',
            gap: 14,
        }}>
            <Box style={{ display: 'flex', flexDirection: 'row', gap: 10, alignItems: 'center' }}>
                <Box style={{ width: 28, height: 28, borderRadius: 4, background: '#C8102E', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold' }}>2</Text>
                </Box>
                <Text style={{ fontSize: 18, color: '#C8102E', fontWeight: 'bold' }}>数据标签</Text>
            </Box>
            <Text style={{ fontSize: 13, color: '#999999' }}>结构化加工层</Text>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
                <Box style={{ background: '#F8F8F8', borderRadius: 6, padding: 12, display: 'flex', flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 14, color: '#C8102E', fontWeight: 'bold' }}>来源</Text>
                    <Text style={{ fontSize: 12, color: '#666666' }}>标记数据出处与采集渠道</Text>
                </Box>
                <Box style={{ background: '#F8F8F8', borderRadius: 6, padding: 12, display: 'flex', flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 14, color: '#C8102E', fontWeight: 'bold' }}>分类</Text>
                    <Text style={{ fontSize: 12, color: '#666666' }}>按问题类型 / 场景归类</Text>
                </Box>
                <Box style={{ background: '#F8F8F8', borderRadius: 6, padding: 12, display: 'flex', flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 14, color: '#C8102E', fontWeight: 'bold' }}>摘要</Text>
                    <Text style={{ fontSize: 12, color: '#666666' }}>语义压缩，支持快速检索</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{
            flex: 1,
            border: '1px solid #E5E5E5',
            borderRadius: 8,
            padding: 20,
            display: 'flex',
            flexDirection: 'column',
            gap: 14,
        }}>
            <Box style={{ display: 'flex', flexDirection: 'row', gap: 10, alignItems: 'center' }}>
                <Box style={{ width: 28, height: 28, borderRadius: 4, background: '#C8102E', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold' }}>3</Text>
                </Box>
                <Text style={{ fontSize: 18, color: '#C8102E', fontWeight: 'bold' }}>数据分析</Text>
            </Box>
            <Text style={{ fontSize: 13, color: '#999999' }}>价值提炼层</Text>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                <Box style={{ display: 'flex', flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#C8102E', marginTop: 6, flexShrink: 0 }} />
                    <Box style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 14, color: '#333333', fontWeight: 'bold' }}>相关性分析</Text>
                        <Text style={{ fontSize: 12, color: '#999999' }}>问题与根因的关联挖掘</Text>
                    </Box>
                </Box>
                <Box style={{ display: 'flex', flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#C8102E', marginTop: 6, flexShrink: 0 }} />
                    <Box style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 14, color: '#333333', fontWeight: 'bold' }}>分布概率</Text>
                        <Text style={{ fontSize: 12, color: '#999999' }}>高频问题模式识别</Text>
                    </Box>
                </Box>
                <Box style={{ display: 'flex', flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#C8102E', marginTop: 6, flexShrink: 0 }} />
                    <Box style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 14, color: '#333333', fontWeight: 'bold' }}>方法论</Text>
                        <Text style={{ fontSize: 12, color: '#999999' }}>从案例归纳可复用规则</Text>
                    </Box>
                </Box>
                <Box style={{ display: 'flex', flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#C8102E', marginTop: 6, flexShrink: 0 }} />
                    <Box style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 14, color: '#333333', fontWeight: 'bold' }}>语义缓存</Text>
                        <Text style={{ fontSize: 12, color: '#999999' }}>特征向量存储与检索</Text>
                    </Box>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{
        background: '#F8F8F8',
        borderLeft: '4px solid #C8102E',
        borderRadius: 4,
        padding: 12,
        marginTop: 16,
    }}>
        <Text style={{ fontSize: 14, color: '#333333', lineHeight: 1.6 }}>
            <span style={{ fontWeight: 'bold', color: '#C8102E' }}>核心逻辑</span>：采集 → 标签 → 分析，形成数据闭环；方法论从数据中生长，而非凭空设计
        </Text>
    </Box>
</Slide>