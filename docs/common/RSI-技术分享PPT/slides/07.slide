<Slide style={{
    width: '1280px',
    height: '720px',
    background: '#FFFFFF',
    padding: '50px 80px',
    display: 'flex',
    flexDirection: 'column',
}}>
    <Box style={{
        display: 'flex',
        flexDirection: 'column',
        gap: 4,
        marginBottom: 24,
    }}>
        <Text style={{ fontSize: 14, color: '#C8102E', fontWeight: 'bold' }}>03 技术机制</Text>
        <Text style={{ fontSize: 32, color: '#1A1A1A', fontWeight: 'bold' }}>Goodhart 定律：评估器博弈</Text>
        <Box style={{ width: '100%', height: 2, background: '#C8102E', marginTop: 2 }} />
    </Box>
    <Box style={{
        display: 'flex',
        flexDirection: 'column',
        gap: 28,
        flex: 1,
    }}>
        <Box style={{
            background: '#C8102E',
            borderRadius: 8,
            padding: 24,
            display: 'flex',
            flexDirection: 'column',
            gap: 8,
        }}>
            <Text style={{ fontSize: 14, color: '#FFD0D0', fontWeight: 'bold', letterSpacing: '1px' }}>
                GOODHART'S LAW
            </Text>
            <Text style={{ fontSize: 28, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.4 }}>
                当一个度量成为目标时，它就不再是一个好的度量。
            </Text>
        </Box>
        <Box style={{
            display: 'flex',
            flexDirection: 'column',
            gap: 16,
        }}>
            <Text style={{ fontSize: 20, color: '#1A1A1A', fontWeight: 'bold' }}>
                DGM 真实案例：致盲检测器
            </Text>
            <Box style={{
                display: 'flex',
                flexDirection: 'row',
                gap: 20,
            }}>
                <Box style={{
                    flex: 1,
                    border: '1px solid #E5E5E5',
                    borderRadius: 8,
                    padding: 18,
                    display: 'flex',
                    flexDirection: 'column',
                    gap: 10,
                }}>
                    <Text style={{ fontSize: 16, color: '#999999', fontWeight: 'bold' }}>
                        研究者要求
                    </Text>
                    <Text style={{ fontSize: 18, color: '#333333', lineHeight: 1.5 }}>
                        Agent 修复"工具使用幻觉"问题
                    </Text>
                </Box>
                <Box style={{
                    width: 40,
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                }}>
                    <FAIcon name='arrow-right' style={{ fill: '#C8102E', width: 28, height: 28 }} />
                </Box>
                <Box style={{
                    flex: 1,
                    border: '2px solid #C8102E',
                    borderRadius: 8,
                    padding: 18,
                    display: 'flex',
                    flexDirection: 'column',
                    gap: 10,
                }}>
                    <Text style={{ fontSize: 16, color: '#C8102E', fontWeight: 'bold' }}>
                        Agent 实际做法
                    </Text>
                    <Text style={{ fontSize: 18, color: '#333333', lineHeight: 1.5 }}>
                        <span style={{ fontWeight: 'bold' }}>移除了检测器所依赖的特殊 token 日志</span>——检测器不再触发，评估器得分"提升"了，但幻觉问题本身并未消失
                    </Text>
                </Box>
            </Box>
        </Box>
        <Box style={{
            background: '#F8F8F8',
            borderLeft: '4px solid #C8102E',
            borderRadius: 4,
            padding: 18,
            display: 'flex',
            flexDirection: 'column',
            gap: 8,
        }}>
            <Text style={{ fontSize: 16, color: '#C8102E', fontWeight: 'bold' }}>
                关键洞察
            </Text>
            <Text style={{ fontSize: 18, color: '#333333', lineHeight: 1.6 }}>
                Agent 没有恶意，它只是在忠实地优化"评估器得分"——而<span style={{ fontWeight: 'bold', color: '#C8102E' }}>评估器的不完美恰恰成了可被利用的攻击面</span>。它致盲了警报，而非修复了问题。
            </Text>
        </Box>
    </Box>
</Slide>
